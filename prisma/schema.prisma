generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════
// ROLES & PERMISSIONS
// ═══════════════════════════════════════════════════════════

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // SUPER_ADMIN, ADMIN, MODERATOR, FREE_USER, PREMIUM_USER, ELITE_USER
  displayName String
  level       Int      @default(0) // Higher = more privilege
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. users.read, users.approve, admin.dashboard
  module      String   // e.g. users, admin, matrimony, business
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// ═══════════════════════════════════════════════════════════
// USER AUTHENTICATION
// ═══════════════════════════════════════════════════════════

model User {
  id            String    @id @default(cuid())
  email         String?
  emailVerified Boolean   @default(false)
  phone         String?
  phoneVerified Boolean   @default(false)
  passwordHash  String?
  authProvider  String    @default("LOCAL") // LOCAL, GOOGLE, FACEBOOK

  // Status & Role
  status        String    @default("PENDING_APPROVAL") // PENDING_APPROVAL, ACTIVE, REJECTED, BLOCKED, DEACTIVATED
  roleId        String?
  membershipTier String   @default("FREE") // FREE, PREMIUM, ELITE
  registrationCategory String @default("GENERAL") // MATRIMONY, BUSINESS, JOB, DIRECTORY, GENERAL

  // Security
  lastLoginAt   DateTime?
  loginCount    Int       @default(0)
  failedLoginAttempts Int @default(0)
  lockedUntil   DateTime?
  mustChangePassword Boolean @default(false)

  // Metadata
  deviceId      String?
  ipAddress     String?
  userAgent     String?
  acceptedTerms Boolean   @default(false)
  deletedAt     DateTime? // Soft delete

  // Multi-tenant ready
  organizationId String? // Future multi-org support

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  role          Role?     @relation(fields: [roleId], references: [id])
  profile       Profile?
  otpVerifications OtpVerification[]
  approvals     Approval[]
  memberships   Membership[]
  auditLogs     AuditLog[]
  securityEvents SecurityEvent[]
  sentNotifications Notification[]
  contactRequestsSent    ContactRequest[]  @relation("SentRequests")
  contactRequestsReceived ContactRequest[] @relation("ReceivedRequests")
  sentAppointmentRequests AppointmentRequest[] @relation("SentAppointments")
  receivedAppointmentRequests AppointmentRequest[] @relation("ReceivedAppointments")
  media         Media[]
  loginHistory  LoginHistory[]
  sessions      UserSession[]
  advertisements Advertisement[]
  reviewedApprovals Approval[] @relation("Reviewer")
  reports           Report[]  @relation("ReporterReports")
  reviewedReports   Report[]  @relation("ReviewerReports")
  blockedUsers      UserBlock[] @relation("Blocker")
  blockedBy         UserBlock[] @relation("Blocked")
  payments          Payment[]  @relation("UserPayments")
  jobs              Job[]      @relation("EmployerJobs")
  jobApplications   JobApplication[] @relation("CandidateApplications")
  businesses        Business[]  @relation("OwnerBusinesses")
  directories       Directory[] @relation("OwnerDirectories")
}

// ═══════════════════════════════════════════════════════════
// GOTRA MASTER
// ═══════════════════════════════════════════════════════════

model Gotra {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  profiles  Profile[]

  @@index([isActive])
  @@index([name])
  @@index([slug])
}

// ═══════════════════════════════════════════════════════════
// USER PROFILE (Expandable per registration category)
// ═══════════════════════════════════════════════════════════

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique

  // Basic Info
  firstName   String?
  lastName    String?
  displayName String?
  gender      String?  // MALE, FEMALE, OTHER
  dateOfBirth String?
  // Marital status for matrimony
  maritalStatus String? // NEVER_MARRIED, DIVORCED, WIDOWED
  // Gotra for community matching (relation to Gotra master)
  gotraId     String?
  gotra       String? // Legacy free-text — preserved during migration

  // Location
  address     String?
  city        String?
  state       String?
  country     String   @default("India")
  pincode     String?

  // Professional
  occupation   String?
  education    String?
  annualIncome String?
  companyName  String?
  designation  String?

  // Matrimony Specific
  height       String?
  familyType   String?  // JOINT, NUCLEAR
  fatherName   String?
  motherName   String?
  familyCity   String?
  aboutFamily  String?
  partnerPreferences String? // JSON string for future parsing

  // Business Specific
  businessName     String?
  businessCategory String?
  businessType     String?  // SOLE_PROPRIETORSHIP, PARTNERSHIP, PVT_LTD, LLP
  businessAddress  String?
  businessCity     String?
  businessState    String?
  businessPincode  String?
  businessPhone    String?
  businessEmail    String?
  businessWebsite  String?
  gstNumber        String?
  businessDescription String?
  businessFounded  String?
  employeeCount    String?

  // Community / Directory Specific
  organizationName  String?
  organizationType  String? // TRUST, SAMITI, SANGATHAN, ASSOCIATION
  organizationRole  String? // PRESIDENT, SECRETARY, MEMBER, TREASURER
  memberCount       String?
  organizationDesc  String?

  // Privacy Controls
  phoneVisible       Boolean @default(false)
  emailVisible       Boolean @default(false)
  profileVisible     Boolean @default(true)
  contactPermission  String  @default("MEMBERS_ONLY") // EVERYONE, MEMBERS_ONLY, PREMIUM_ONLY, NONE

  // Social
  bio         String?
  profilePhotoUrl String?
  coverPhotoUrl  String?
  socialLinks    String? // JSON string

  // AI Ready fields
  aiTags          String? // JSON string for AI-generated tags
  aiMatchScore    Float?
  aiVerified      Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gotraMaster Gotra?   @relation(fields: [gotraId], references: [id], onDelete: SetNull)
  locations   Location[] @relation("ProfileLocation")
  matrimonyProfile MatrimonyProfile?

  @@index([gotraId])
}

// ═══════════════════════════════════════════════════════════
// OTP VERIFICATION
// ═══════════════════════════════════════════════════════════

model OtpVerification {
  id          String   @id @default(cuid())
  userId      String?
  type        String   // REGISTRATION, LOGIN, RESET_PASSWORD, CHANGE_PHONE, CHANGE_EMAIL
  method      String   // SMS, EMAIL, BOTH
  identifier  String   // phone number or email
  otpCode     String
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  verified    Boolean  @default(false)
  expiresAt   DateTime
  verifiedAt  DateTime?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════
// APPROVAL WORKFLOW
// ═══════════════════════════════════════════════════════════

model Approval {
  id           String   @id @default(cuid())
  userId       String
  action       String   // APPROVE, REJECT, BLOCK, UNBLOCK
  reason       String?
  reviewedBy   String?  // Admin user ID
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  aiProcessed  Boolean  @default(false)
  createdAt    DateTime @default(now())
  reviewedAt   DateTime?

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer     User?    @relation("Reviewer", fields: [reviewedBy], references: [id])
}

// ═══════════════════════════════════════════════════════════
// MEMBERSHIP & SUBSCRIPTION
// ═══════════════════════════════════════════════════════════

model Membership {
  id             String   @id @default(cuid())
  userId         String
  tier           String   // FREE, PREMIUM, ELITE
  status         String   @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  startedAt      DateTime @default(now())
  expiresAt      DateTime?
  paymentMethod  String?  // UPI, CARD, BANK_TRANSFER
  paymentRef     String?
  amount         Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════
// MEDIA STORAGE
// ═══════════════════════════════════════════════════════════

model Media {
  id          String   @id @default(cuid())
  userId      String?
  category    String   // PROFILE, BUSINESS, ADVERTISEMENT, DOCUMENT, GENERAL
  type        String   // IMAGE, VIDEO, DOCUMENT
  fileName    String
  fileSize    Int
  mimeType    String
  url         String
  thumbnailUrl String?
  width       Int?
  height      Int?
  alt         String?
  sortOrder   Int      @default(0)
 isPublic    Boolean  @default(true)
  aiModerated Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════
// NOTIFICATIONS
// ═══════════════════════════════════════════════════════════

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String   // REGISTRATION, APPROVAL, REJECTION, CONTACT_REQUEST, APPOINTMENT, MEMBERSHIP, SYSTEM
  title       String
  message     String
  data        String?  // JSON string for additional payload
  channel     String   @default("IN_APP") // IN_APP, EMAIL, SMS, PUSH
  read        Boolean  @default(false)
  readAt      DateTime?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════
// CONTACT & APPOINTMENT REQUESTS
// ═══════════════════════════════════════════════════════════

model ContactRequest {
  id              String   @id @default(cuid())
  senderId        String
  receiverId      String
  message         String?
  status          String   @default("PENDING") // PENDING, ACCEPTED, REJECTED, BLOCKED
  createdAt        DateTime @default(now())
  respondedAt      DateTime?

  sender          User     @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver        User     @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

// ═══════════════════════════════════════════════════════════
// AUDIT LOG
// ═══════════════════════════════════════════════════════════

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String   // e.g. user.login, admin.approve_user, profile.update
  entity      String?  // e.g. User, Profile, Approval
  entityId    String?
  details     String?  // JSON string
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ═══════════════════════════════════════════════════════════
// SECURITY EVENTS
// ═══════════════════════════════════════════════════════════

model SecurityEvent {
  id          String   @id @default(cuid())
  userId      String?
  eventType   String   // LOGIN_SUCCESS, LOGIN_FAILURE, ACCOUNT_LOCKED, PASSWORD_CHANGED, OTP_FAILED, SUSPICIOUS_ACTIVITY
  description String?
  ipAddress   String?
  userAgent   String?
  metadata    String?  // JSON string
  severity    String   @default("INFO") // INFO, WARNING, CRITICAL
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ═══════════════════════════════════════════════════════════
// LOGIN HISTORY (Device Tracking)
// ═══════════════════════════════════════════════════════════

model LoginHistory {
  id          String   @id @default(cuid())
  userId      String
  ipAddress   String?
  userAgent   String?
  device      String?
  location    String?
  success     Boolean  @default(true)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════
// USER SESSIONS
// ═══════════════════════════════════════════════════════════

model UserSession {
  id          String   @id @default(cuid())
  userId      String
  token       String   @unique
  device      String?
  ipAddress   String?
  userAgent   String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════
// ADVERTISEMENT
// ═══════════════════════════════════════════════════════════

model Advertisement {
  id          String   @id @default(cuid())
  userId      String?  // Admin who created it
  title       String
  description String?
  imageUrl    String?
  linkUrl     String?
  position    String   // HERO, MIDDLE, BOTTOM, SIDEBAR
  category    String   // MATRIMONY, BUSINESS, JOBS, DIRECTORY, GENERAL
  status      String   @default("ACTIVE") // ACTIVE, PAUSED, EXPIRED
  impressions Int      @default(0)
  clicks      Int      @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ═══════════════════════════════════════════════════════════
// APPOINTMENT REQUESTS
// ═══════════════════════════════════════════════════════════

model AppointmentRequest {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  title       String
  message     String?
  proposedDate String?
  proposedTime String?
  status      String   @default("PENDING") // PENDING, ACCEPTED, REJECTED, CANCELLED, COMPLETED
  createdAt   DateTime @default(now())
  respondedAt DateTime?

  sender      User     @relation("SentAppointments", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User     @relation("ReceivedAppointments", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════
// MEMBERSHIP PLANS
// ═══════════════════════════════════════════════════════════

model MembershipPlan {
  id          String   @id @default(cuid())
  name        String   // FREE, PREMIUM, ELITE
  displayName String
  description String?
  price       Float    @default(0)
  currency    String   @default("INR")
  durationDays Int     @default(30)
  features    String   // JSON string: list of features
  maxContacts Int      @default(10)
  maxPhotos   Int      @default(5)
  priorityListing Boolean @default(false)
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name])
}

// ═══════════════════════════════════════════════════════════
// LOCATION MASTER (Hierarchical: State → District → Tehsil → City → Village)
// ═══════════════════════════════════════════════════════════

model Location {
  id        String   @id @default(cuid())
  name      String
  nameHi    String?
  level     String   // STATE, DISTRICT, TEHSIL, CITY, VILLAGE
  parentId  String?
  slug      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent    Location?  @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Location[] @relation("LocationHierarchy")
  profiles  Profile[]  @relation("ProfileLocation")
  matrimonyDistricts MatrimonyProfile[] @relation("ProfileLocation")
  matrimonyTehsils MatrimonyProfile[] @relation("TehsilLocation")
  matrimonyCities MatrimonyProfile[] @relation("CityLocation")
  jobDistricts Job[] @relation("JobDistrict")
  jobCities Job[] @relation("JobCity")
  businessDistricts Business[] @relation("BusinessDistrict")
  businessCities Business[] @relation("BusinessCity")
  directoryDistricts Directory[] @relation("DirectoryDistrict")
  directoryCities Directory[] @relation("DirectoryCity")

  @@unique([slug])
  @@index([parentId])
  @@index([level])
  @@index([isActive])
}

// ═══════════════════════════════════════════════════════════
// MATRIMONY PROFILE (extends Profile with matrimony-specific data)
// ═══════════════════════════════════════════════════════════

model MatrimonyProfile {
  id                String   @id @default(cuid())
  profileId         String   @unique
  status            String   @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED, BLOCKED
  gender            String   // MALE, FEMALE
  dateOfBirth       String?
  height            String?
  weight            String?
  complexion        String? // FAIR, WHEATISH, DARK
  religion          String   @default("Hindu")
  motherTongue      String?
  maritalStatus     String? // NEVER_MARRIED, DIVORCED, WIDOWED
  aboutMe           String?
  familyDescription String?
  education         String?
  occupation        String?
  annualIncome      String?
  employerName      String?
  workingCity       String?
  districtId        String?
  tehsilId          String?
  cityId            String?
  village           String?
  partnerPreferences String? // JSON
  familyType        String? // JOINT, NUCLEAR
  fatherName        String?
  fatherOccupation  String?
  motherName        String?
  motherOccupation  String?
  siblings          String? // JSON: [{relation, name, occupation, maritalStatus}]
  familyValues      String? // TRADITIONAL, MODERATE, LIBERAL
  contactedCount    Int      @default(0)
  contactLimit      Int      @default(10)
  isFeatured        Boolean  @default(false)
  featuredExpiry    DateTime?
  rejectedAt        DateTime?
  rejectionReason   String?
  approvedAt        DateTime?
  approvedBy        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  district  Location? @relation("ProfileLocation", fields: [districtId], references: [id], onDelete: SetNull)
  tehsil    Location? @relation("TehsilLocation", fields: [tehsilId], references: [id], onDelete: SetNull)
  city      Location? @relation("CityLocation", fields: [cityId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([gender])
  @@index([districtId])
  @@index([tehsilId])
  @@index([cityId])
  @@index([isFeatured])
  @@index([approvedAt])
}

// ═══════════════════════════════════════════════════════════
// JOBS
// ═══════════════════════════════════════════════════════════

model Job {
  id              String   @id @default(cuid())
  employerId      String   // userId of the employer
  title           String
  description     String
  category        String? // IT, HEALTHCARE, EDUCATION, MANUFACTURING, RETAIL, CONSTRUCTION, OTHER
  type            String   @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT, FREELANCE, INTERNSHIP
  salaryMin       String?
  salaryMax       String?
  salaryCurrency  String   @default("INR")
  experience      String? // 0-1, 1-3, 3-5, 5-10, 10+
  skills          String? // JSON array
  education       String?
  vacancies       Int      @default(1)
  location        String?
  districtId      String?
  cityId          String?
  isRemote        Boolean  @default(false)
  isFeatured      Boolean  @default(false)
  featuredExpiry  DateTime?
  status          String   @default("PENDING") // PENDING, ACTIVE, CLOSED, EXPIRED, REJECTED
  contactEmail    String?
  contactPhone    String?
  applyUrl        String?
  viewsCount      Int      @default(0)
  applicationsCount Int    @default(0)
  expiresAt       DateTime?
  approvedAt      DateTime?
  approvedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employer   User      @relation("EmployerJobs", fields: [employerId], references: [id], onDelete: Cascade)
  district  Location? @relation("JobDistrict", fields: [districtId], references: [id], onDelete: SetNull)
  city      Location? @relation("JobCity", fields: [cityId], references: [id], onDelete: SetNull)
  applications JobApplication[]

  @@index([employerId])
  @@index([status])
  @@index([category])
  @@index([type])
  @@index([isFeatured])
  @@index([expiresAt])
  @@index([districtId])
}

model JobApplication {
  id           String   @id @default(cuid())
  jobId        String
  candidateId  String // userId
  status       String   @default("APPLIED") // APPLIED, VIEWED, SHORTLISTED, REJECTED, HIRED, WITHDRAWN
  coverLetter  String?
  resumeUrl    String?
  viewedAt     DateTime?
  shortlistedAt DateTime?
  rejectedAt   DateTime?
  hiredAt      DateTime?
  withdrawnAt  DateTime?
  employerNote String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  job       Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate User @relation("CandidateApplications", fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([jobId, candidateId])
  @@index([candidateId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════
// BUSINESS DIRECTORY
// ═════════════════════════════════════════════════════════

model Business {
  id                String   @id @default(cuid())
  ownerId           String // userId
  name              String
  description       String?
  category          String?
  services          String? // JSON array
  type              String   @default("SOLE_PROPRIETORSHIP") // SOLE_PROPRIETORSHIP, PARTNERSHIP, PVT_LTD, LLP
  address           String?
  districtId        String?
  cityId            String?
  phone             String?
  email             String?
  website           String?
  gstNumber         String?
  workingHours      String? // JSON: {mon:{open,close}, ...}
  foundedYear       String?
  employeeCount     String?
  isVerified        Boolean  @default(false)
  isFeatured        Boolean  @default(false)
  featuredExpiry    DateTime?
  status            String   @default("PENDING") // PENDING, ACTIVE, REJECTED, BLOCKED
  viewsCount        Int      @default(0)
  approvedAt        DateTime?
  approvedBy        String?
  rejectedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner    User      @relation("OwnerBusinesses", fields: [ownerId], references: [id], onDelete: Cascade)
  district Location? @relation("BusinessDistrict", fields: [districtId], references: [id], onDelete: SetNull)
  city     Location? @relation("BusinessCity", fields: [cityId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([status])
  @@index([category])
  @@index([isVerified])
  @@index([isFeatured])
  @@index([districtId])
}

// ═════════════════════════════════════════════════════════
// COMMUNITY DIRECTORY
// ═══════════════════════════════════════════════════════

model Directory {
  id                String   @id @default(cuid())
  ownerId           String // userId
  name              String
  description       String?
  category          String? // TRUST, SAMITI, SANGATHAN, ASSOCIATION, EDUCATIONAL, OTHER
  type              String? // TRUST, SAMITI, SANGATHAN, ASSOCIATION
  address           String?
  districtId        String?
  cityId            String?
  phone             String?
  email             String?
  website           String?
  memberCount       String?
  isVerified        Boolean  @default(false)
  isFeatured        Boolean  @default(false)
  featuredExpiry    DateTime?
  status            String   @default("PENDING") // PENDING, ACTIVE, REJECTED, BLOCKED
  viewsCount        Int      @default(0)
  approvedAt        DateTime?
  approvedBy        String?
  rejectedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner    User      @relation("OwnerDirectories", fields: [ownerId], references: [id], onDelete: Cascade)
  district Location? @relation("DirectoryDistrict", fields: [districtId], references: [id], onDelete: SetNull)
  city     Location? @relation("DirectoryCity", fields: [cityId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([status])
  @@index([category])
  @@index([isVerified])
  @@index([isFeatured])
}

// ═════════════════════════════════════════════════════════
// REPORTS
// ═════════════════════════════════════════════════════════

model Report {
  id            String   @id @default(cuid())
  reporterId    String
  targetType    String   // USER, MATRIMONY_PROFILE, PHOTO, BUSINESS, JOB, DIRECTORY, ADVERTISEMENT
  targetId      String
  reason        String   // INAPPROPRIATE, FRAUD, SPAM, HARASSMENT, COPYRIGHT, OTHER
  description   String?
  status        String   @default("PENDING") // PENDING, REVIEWED, RESOLVED, DISMISSED
  resolution    String?
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reporter  User  @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewer  User? @relation("ReviewerReports", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([targetType])
  @@index([targetId])
  @@index([status])
}

// ═════════════════════════════════════════════════════════
// USER BLOCKS
// ═════════════════════════════════════════════════════════

model UserBlock {
  id         String   @id @default(cuid())
  blockerId  String
  blockedId  String
  reason     String?
  createdAt  DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

// ═════════════════════════════════════════════════════════
// PAYMENTS (Provider-independent)
// ═════════════════════════════════════════════════════════

model Payment {
  id              String   @id @default(cuid())
  userId          String
  provider        String   // RAZORPAY, STRIPE, PAYPAL, UPI, BANK_TRANSFER, MANUAL
  providerTxnId   String?
  amount          Float
  currency        String   @default("INR")
  status          String   @default("INITIATED") // INITIATED, PENDING, SUCCESS, FAILED, REFUNDED, CANCELLED
  purpose         String   // MEMBERSHIP, BUSINESS_FEATURED, JOB_FEATURED, ADVERTISEMENT, SPONSORED_LISTING
  purposeRefId    String? // ID of the entity this payment is for
  membershipTier  String? // FREE, PREMIUM, ELITE
  durationDays    Int?
  metadata        String? // JSON: provider-specific data
  failureReason   String?
  refundReason    String?
  refundedAt      DateTime?
  paidAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation("UserPayments", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([provider])
  @@index([purpose])
  @@index([createdAt])
}

// ═════════════════════════════════════════════════════════
// AD CAMPAIGNS (Enhanced Advertisement)
// ═════════════════════════════════════════════════════════

model AdCampaign {
  id            String   @id @default(cuid())
  name          String
  module        String   // MATRIMONY, BUSINESS, JOBS, DIRECTORY, GENERAL
  placement     String   // HERO, MIDDLE, BOTTOM
  mediaType     String   @default("IMAGE") // IMAGE, VIDEO, LOTTIE
  mediaUrl      String
  mobileMediaUrl String?
  linkUrl       String?
  ctaText       String?
  ctaTextHi     String?
  language      String   @default("ALL") // ALL, EN, HI
  device        String   @default("ALL") // ALL, MOBILE, DESKTOP
  priority      Int      @default(0)
  impressions   Int      @default(0)
  clicks        Int      @default(0)
  status        String   @default("ACTIVE") // ACTIVE, PAUSED, EXPIRED
  startDate     DateTime?
  endDate       DateTime?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([module])
  @@index([placement])
  @@index([status])
  @@index([priority])
  @@index([startDate, endDate])
  impressionRecords AdImpression[]
  clickRecords      AdClick[]
}

// ═════════════════════════════════════════════════════════
// SYSTEM CONFIGURATION (Key-Value Store)
// ═══════════════════════════════════════════════════════════

model SystemConfiguration {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   // JSON string for complex values
  description String?
  category    String   // GENERAL, SECURITY, NOTIFICATION, MEMBERSHIP, AI, ADVERTISEMENT
  isPublic    Boolean  @default(false) // Whether frontend can read this
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

// ═══════════════════════════════════════════════════════════
// PHASE 4 — AI INTELLIGENCE LAYER
// ═══════════════════════════════════════════════════════════

model AIProviderConfig {
  id            String   @id @default(cuid())
  provider      String   @unique  // ZAI, OPENAI, GOOGLE, ANTHROPIC, LOCAL
  displayName   String
  description   String?
  enabled       Boolean  @default(true)
  config        String   // JSON: { apiKey, baseUrl, model, maxTokens, etc. }
  capabilities  String   // JSON array: ["chat","vision","moderation","matching"]
  priority      Int      @default(0)  // Higher = preferred
  rateLimitRpm  Int      @default(60)
  costPer1kTok  Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([enabled])
  @@index([priority])
}

model AIRequest {
  id            String   @id @default(cuid())
  userId        String?
  operation     String   // MATCH, MODERATE, RECOMMEND, ASSIST, TRANSLATE, ANALYZE, EDIT, SMART_SEARCH, JOB_MATCH, BUSINESS_REC, DIRECTORY_REC, ADMIN_COPILOT, RISK_ANALYSIS, PROFILE_ASSIST
  provider      String   // ZAI, OPENAI, GOOGLE, ANTHROPIC, LOCAL
  model         String?
  inputHash     String?  // For deduplication
  inputSummary  String?  // Non-sensitive description of the request
  status        String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, CANCELLED
  resultStatus  String?  // SAFE, REVIEW, BLOCKED, LOW, MEDIUM, HIGH (operation-specific)
 confidence    Float?
 durationMs    Int?
 inputTokens   Int?
  outputTokens  Int?
  costUsd       Float?
  error         String?
  createdAt     DateTime @default(now())
  completedAt   DateTime?

  results       AIResult[]

  @@index([userId])
  @@index([operation])
  @@index([status])
  @@index([provider])
  @@index([inputHash])
  @@index([createdAt])
}

model AIResult {
  id            String   @id @default(cuid())
  requestId     String
  operation     String
  targetType    String?  // PROFILE, MEDIA, JOB, BUSINESS, DIRECTORY, USER
  targetId      String?
  resultJson    String   // Structured JSON result
  score         Float?
  metadata      String?  // Additional context
  createdAt     DateTime @default(now())

  request       AIRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([operation])
  @@index([targetType, targetId])
}

model AIRecommendation {
  id            String   @id @default(cuid())
  userId        String
  type          String   // MATRIMONY, JOB, BUSINESS, DIRECTORY
  targetId      String
  score         Float
  factors       String   // JSON: [{name, weight, matched}]
  reason        String?
  reasonHi      String?
  engaged       Boolean  @default(false)  // User clicked/viewed
  dismissed     Boolean  @default(false)  // User dismissed
  expiresAt     DateTime?
  createdAt     DateTime @default(now())

  @@index([userId, type])
  @@index([userId, type, createdAt])
  @@index([targetId])
  @@index([score])
  @@index([expiresAt])
}

model MatchScore {
  id              String   @id @default(cuid())
  profileIdA      String
  profileIdB      String
  overallScore    Float
  gotraScore      Float    @default(0)
  locationScore   Float    @default(0)
  educationScore  Float    @default(0)
  occupationScore Float    @default(0)
  ageScore        Float    @default(0)
  preferenceScore Float    @default(0)
  aiScore         Float    @default(0)  // AI-enhanced component
  factorsJson     String   // Detailed factor breakdown
  recommendation  String   @default("NONE") // NONE, RECOMMENDED, POTENTIAL, NOT_RECOMMENDED
  confidence      Float?
  aiRequestId     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([profileIdA, profileIdB])
  @@index([profileIdA])
  @@index([profileIdB])
  @@index([overallScore])
  @@index([recommendation])
}

model ModerationResult {
  id            String   @id @default(cuid())
  mediaId       String   @unique
  verdict       String   // SAFE, REVIEW, BLOCKED
  confidence    Float
  flags         String   // JSON array: ["nudity", "violence", ...]
  autoAction    String   // NONE, BLUR, HIDE, FLAG_FOR_REVIEW
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewOutcome String?  // UPHELD, OVERTURNED, ESCALATED
  aiRequestId   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([verdict])
  @@index([mediaId])
  @@index([createdAt])
}

model RiskAssessment {
  id            String   @id @default(cuid())
  userId        String?
  targetType    String   // USER, BUSINESS, JOB, ADVERTISEMENT, DIRECTORY
  targetId      String?
  riskLevel     String   @default("LOW") // LOW, MEDIUM, HIGH
  riskScore     Float    @default(0)  // 0-100
  signals       String   // JSON array of detected signals
  actionTaken   String?  // NONE, FLAGGED, NOTIFIED_ADMIN, AUTO_BLOCKED
  aiRequestId   String?
  resolvedBy    String?
  resolvedAt    DateTime?
  resolution    String?  // DISMISSED, CONFIRMED, ESCALATED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([targetType, targetId])
  @@index([riskLevel])
  @@index([createdAt])
}

model AIUsage {
  id            String   @id @default(cuid())
  date          String   // YYYY-MM-DD for daily aggregation
  operation     String
  provider      String
  model         String?
  totalRequests Int      @default(0)
  successCount  Int      @default(0)
  failCount     Int      @default(0)
  totalInputTok Int      @default(0)
  totalOutputTok Int     @default(0)
  totalCostUsd  Float    @default(0)
  avgLatencyMs  Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([date, operation, provider, model])
  @@index([date])
  @@index([operation])
  @@index([provider])
}

model UserPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  preferences   String   // JSON: {searchHistory, language, interactionSignals, savedItems, matrimonyPrefs, jobPrefs}
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

// ═══════════════════════════════════════════════════════════
// PHASE 5 — PRODUCTION HARDENING
// ═══════════════════════════════════════════════════════════

model BackupRecord {
  id            String   @id @default(cuid())
  type          String   // DATABASE, MEDIA, CONFIG
  status        String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, FAILED
  filePath      String?
  fileSize      Int?
  checksum      String?
  triggeredBy   String?  // userId or SYSTEM
  triggeredByRole String?
  notes         String?
  retentionDays Int      @default(90)
 expiresAt     DateTime?
  completedAt   DateTime?
  error         String?
  createdAt     DateTime @default(now())

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model ScheduledTask {
  id            String   @id @default(cuid())
  name          String   @unique
  type          String   // AD_EXPIRY, JOB_EXPIRY, MEMBERSHIP_EXPIRY, SESSION_CLEANUP, BACKUP, HEALTH_CHECK, NOTIFICATION_RETRY, AI_PROVIDER_CHECK
  cronExpression String?
  intervalMinutes Int?
  isEnabled     Boolean  @default(true)
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  lastStatus    String?  // SUCCESS, FAILED
  lastError     String?
  metadata      String?  // JSON: task-specific config
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isEnabled])
  @@index([type])
  @@index([nextRunAt])
}

model AdImpression {
  id            String   @id @default(cuid())
  campaignId    String
  ipAddress     String?
  userAgent     String?
  device        String?  // MOBILE, DESKTOP, TABLET
  language      String?
  module        String?
  placement     String?
  createdAt     DateTime @default(now())

  campaign      AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([createdAt])
  @@index([device])
  @@index([module])
}

model AdClick {
  id            String   @id @default(cuid())
  campaignId    String
  impressionId  String?
  ipAddress     String?
  userAgent     String?
  device        String?
  language      String?
  module        String?
  placement     String?
  createdAt     DateTime @default(now())

  campaign      AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([createdAt])
  @@index([device])
}
