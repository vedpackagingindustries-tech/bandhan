# ═══════════════════════════════════════════════════════════
# BANDHAN — Environment Configuration Template
# Copy this to .env and fill in your values.
# ═══════════════════════════════════════════════════════════

# ─── DATABASE (Supabase PostgreSQL) ───
# Pooler URL for runtime connections (pgbouncer, port 6543)
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Direct URL for migrations (port 5432)
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# ─── SUPABASE ───
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── SECURITY (REQUIRED) ───
# HMAC secret for OTP hashing — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
OTP_HASH_SECRET=your_otp_hash_secret_here

# ─── EMAIL (Resend — free tier: 100/day) ───
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Bandhan <noreply@yourdomain.com>

# ─── SMS / WHATSAPP (Twilio) ───
TWILIO_ACCOUNT_SID=ACxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+14155238886

# ─── SMS FALLBACK (MSG91 — India-focused) ───
MSG91_API_KEY=your_msg91_key
MSG91_OTP_TEMPLATE_ID=your_template_id

# ─── AI PROVIDERS (Optional) ───
OPENAI_API_KEY=sk-xxxxxxxxxxxx
GOOGLE_AI_API_KEY=your_google_ai_key

# ─── NEXTAUTH (if used) ───
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000
